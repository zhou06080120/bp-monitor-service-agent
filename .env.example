# ═════════════════════════════════════════════════════════════════
# 环境变量模板：cp .env.example .env 后按需填写
# 原则：全部可选项缺省时系统自动降级到零依赖形态（hash/inprocess/local），
#       任何环境都能启动——这是企业级"可用性优先"策略。
# ═════════════════════════════════════════════════════════════════

# ── LLM（Agent 回答 / Reviewer 复盘 / Judge 裁决共用 DeepSeek 兼容协议） ──────
# 无 Key 时 Agent 用占位符延迟报错，评估自动降级为纯规则模式
DEEPSEEK_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ── LLM Judge（第二裁判：语义级 pass/fail 翻案） ──────────────────────────────
JUDGE_MODEL=deepseek-chat
JUDGE_API_KEY=
JUDGE_API_BASE=https://api.deepseek.com
JUDGE_VOTE=1

# ── 嵌入层（EMBED_PROVIDER: hash | local | api | auto） ───────────────────────
# hash = 零依赖特征哈希（默认兜底）；local = 本地 sentence-transformers；
# api  = OpenAI 兼容 Embedding API
EMBED_PROVIDER=auto
BP_EMBED_MODEL_DIR=
BP_EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_API_KEY=
EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024

# ── 向量库（未启用时用进程内 LocalVectorStore） ───────────────────────────────
MILVUS_ENABLED=0
MILVUS_URI=tcp://localhost:19530
MILVUS_DIM=256

# ── 异步任务后端（TASK_BACKEND: inprocess | celery） ──────────────────────────
# celery 需先启动 Redis 并单独运行 Worker：
#   celery -A src.celery_app worker --loglevel=info --pool=solo
TASK_BACKEND=inprocess
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── 评估模式与阈值（EVAL_MODE: rule | semantic | hybrid | llm | auto） ─────────
# auto = 按 Key 可用性自动选择（无 Key → rule）
EVAL_MODE=auto
EVAL_GATE_MARGIN=0.10
EVAL_SIM_CLEAR_PASS=0.30
EVAL_SIM_RESCUE_FLOOR=0.30
EVAL_JUDGE_RESCUE_CONF=0.70
EVAL_JUDGE_OVERTURN_CONF=0.85
