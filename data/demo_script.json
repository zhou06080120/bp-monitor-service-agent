{
  "description": "演示脚本：80题，nudge_interval=10，每块10题同类别，每次Nudge有清晰失败信号",
  "nudge_interval": 10,
  "probe_question_ids": [1, 2, 3, 7, 10, 11, 13, 15, 16, 17, 23, 24, 27, 31, 32, 35, 36, 39, 40, 47, 48, 49, 55, 58, 59, 60, 19, 20, 21, 22],
  "expected_evolutions": [
    {
      "after_seq": 10,
      "block": "device_basic",
      "trigger_reason": "设备基础问题大多答对，Reviewer预期无需大改或小幅补充型号差异分支",
      "expected_action": "none_or_minor_patch",
      "expected_skill": "device_usage"
    },
    {
      "after_seq": 20,
      "block": "cuff_positioning",
      "trigger_reason": "袖带与姿势连续10题全部失败，Reviewer发现完全缺失袖带知识",
      "expected_action": "patch_or_create",
      "expected_skill": "device_usage（补袖带规则）或 cuff_positioning（新建）"
    },
    {
      "after_seq": 30,
      "block": "measurement_accuracy",
      "trigger_reason": "多次取值/校准/心律不齐等测量规则题频繁失败，Reviewer发现measurement缺少测量细节",
      "expected_action": "patch",
      "expected_skill": "measurement（补多次取值和校准规则）"
    },
    {
      "after_seq": 40,
      "block": "app_sync",
      "trigger_reason": "APP蓝牙配对/数据同步/多设备绑定全部失败，Reviewer发现完全缺失APP连接知识",
      "expected_action": "create",
      "expected_skill": "app_connection（新建）"
    },
    {
      "after_seq": 50,
      "block": "abnormal_readings",
      "trigger_reason": "高血压分级/紧急提醒/低血压判断全部失败，Reviewer发现完全缺失异常读数知识",
      "expected_action": "create",
      "expected_skill": "abnormal_readings（新建）"
    },
    {
      "after_seq": 60,
      "block": "after_sales",
      "trigger_reason": "保修/退换货/维修费用等售后规则失败，Reviewer发现完全缺失售后知识",
      "expected_action": "create",
      "expected_skill": "after_sales（新建）"
    },
    {
      "after_seq": 70,
      "block": "model_differences",
      "trigger_reason": "型号差异/特殊人群等交叉点题失败，Reviewer发现边界规则缺失",
      "expected_action": "patch",
      "expected_skill": "device_usage或measurement（补型号差异和特殊人群）"
    },
    {
      "after_seq": 80,
      "block": "mixed_validation",
      "trigger_reason": "综合各类题，发现零散遗漏，微调现有Skills",
      "expected_action": "patch",
      "expected_skill": "各Skill小幅优化"
    }
  ],
